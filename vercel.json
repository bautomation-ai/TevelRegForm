{
  "version": 2,
  "builds": [
    {
      "src": "newlogo.png",
      "use": "@vercel/static"
    },
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["trip-registration.html", "thank-you.html"]
      }
    }
  ],
  "routes": [
    {
      "src": "/newlogo.png",
      "dest": "/newlogo.png"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
